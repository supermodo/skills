{
  "configVersion": 1,
  "docs": {
    "entry": "documentation/README.md",
    "conventions": "documentation/CONVENTIONS.md",
    "layout": {
      "root": "docs"
    }
  },
  "commands": {
    "test": [
      "deno",
      "task",
      "test"
    ]
  },
  "workspace": {
    "worktree": true
  },
  "coverage": {
    "target": 80
  },
  "questions": {
    "transport": "chat"
  },
  "confirmations": {
    "mode": "ask",
    "perSkill": {
      "release": "auto"
    }
  },
  "reports": {
    "html": true,
    "open": "auto"
  },
  "changelog": {
    "fragments": true,
    "dir": "changes"
  },
  "release": {
    "branches": {
      "main": "main",
      "dev": "dev"
    },
    "versionFile": "package.json",
    "versionPath": "version",
    "changelog": "CHANGELOG.md",
    "tagPrefix": "v",
    "mergeStrategy": "squash",
    "mergeStrategy": "squash"
  },
  "agents": {
    "dir": ".supermodo/agents"
  },
  "vcs": {
    "issueKey": {
      "pattern": "^(?:feature|fix)/([A-Z]+-[0-9]+)-",
      "template": "[{key}] {type}: {subject}"
    }
  }
}
