{
  "configVersion": 1,
  "docs": {
    "entry": "docs/README.md",
    "conventions": "docs/CONVENTIONS.md"
  },
  "commands": {
    "test": [
      "deno",
      "task",
      "test"
    ]
  },
  "workspace": {
    "worktree": true
  },
  "coverage": {
    "target": 80
  },
  "questions": {
    "transport": "chat"
  },
  "confirmations": {
    "mode": "ask",
    "perSkill": {
      "release": "auto"
    }
  },
  "reports": {
    "html": true,
    "open": "auto"
  },
  "changelog": {
    "fragments": true,
    "dir": "changes"
  },
  "release": {
    "branches": {
      "main": "main",
      "dev": "dev"
    },
    "versionFile": "package.json",
    "versionPath": "version",
    "changelog": "CHANGELOG.md",
    "tagPrefix": "v",
    "mergeStrategy": "squash",
    "mergeStrategy": "squash"
  },
  "agents": {
    "dir": ".supermodo/agents"
  },
  "multimodel": {
    "classes": {
      "s-security-audit": { "extends": "adversary" }
    },
    "variants": { "hunt": "deep", "*": "standard" },
    "forbid": { "reviewer": ["lineage:anthropic", "claude-fable-5-1"] },
    "require": { "adversary": ["lineage:openai"] },
    "concurrency": 2,
    "budget": { "callsPerRun": 40 }
  },
  "vcs": {
    "issueKey": {
      "pattern": "^(?:feature|fix)/([A-Z]+-[0-9]+)-",
      "template": "[{key}] {type}: {subject}"
    }
  }
}
